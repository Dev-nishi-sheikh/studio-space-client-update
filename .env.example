# Leave NEXT_PUBLIC_API_URL empty to run the app in local demo mode
# (seeded listings, bookings and auth are persisted in the browser).
# Point it at the Express API to run against the real MongoDB backend,
# for example: NEXT_PUBLIC_API_URL=https://studiospace-api.onrender.com/api
NEXT_PUBLIC_API_URL=

# Optional: imgbb key used by the "Upload image" control on studio forms.
# Without a key, the client falls back to a compressed local data URL.
NEXT_PUBLIC_IMGBB_API_KEY=

# Set to "true" to force demo mode even when an API URL is present.
NEXT_PUBLIC_DEMO_MODE=

# Google credentials belong in the separate Express server environment only.
# NEXT_PUBLIC_* variables must never contain Google client secrets.